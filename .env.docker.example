# ==============================================================================
# SIIA - Sistema Inteligente de Inventario y Activos UOD
# Plantilla de Variables de Entorno para Despliegue con Docker (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración de Dominio y Puertos
# ------------------------------------------------------------------------------
APP_DOMAIN=siia.uod.edu.do
BACKEND_PORT=5000
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# 2. Supabase (Base de Datos PostgreSQL, Auth y Storage)
# ------------------------------------------------------------------------------
# URL del proyecto Supabase (ejemplo: https://xxxxxxxx.supabase.co)
SUPABASE_URL=https://xgwuxkvbdwxwflynanwo.supabase.co

# Clave anónima pública de Supabase (anon public key)
SUPABASE_ANON_KEY=tu_clave_anonima_publica_aqui

# Clave de servicio de Supabase (service_role secret - confidencial)
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_aqui

# Cadena de conexión PostgreSQL directa o via Pooler (PgBouncer en modo sesión, puerto 5432 o 6543)
DATABASE_CONNECTION_STRING=Host=aws-0-us-east-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.xgwuxkvbdwxwflynanwo;Password=tu_password_aqui;SSL Mode=Require;Trust Server Certificate=true;

# ------------------------------------------------------------------------------
# 3. Google Gemini API (Asistente de Inteligencia Artificial)
# ------------------------------------------------------------------------------
# Clave de API de Google AI Studio / Gemini
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ------------------------------------------------------------------------------
# 4. Notificaciones por Correo Electrónico (Gmail API / SMTP Institucional)
# ------------------------------------------------------------------------------
GMAIL_USER=inventario.siia@uod.edu.do
GMAIL_APP_PASSWORD=tu_contrasena_de_aplicacion_gmail_16_caracteres

# ------------------------------------------------------------------------------
# 5. URLs Públicas de Frontend
# ------------------------------------------------------------------------------
# En despliegue local: http://localhost:5000/api/v1
# En producción detrás de Nginx: /api/v1 o https://siia.uod.edu.do/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://xgwuxkvbdwxwflynanwo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anonima_publica_aqui
